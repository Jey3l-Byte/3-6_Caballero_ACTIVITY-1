<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Biodata Form</title>
    <link rel="stylesheet" href="/form.css">
</head>

<body>
    <div class="form-container">
        <div class="form-header">Biodata Form</div>
        <div class="form-body">
            <div class="form-note"><strong>Note:</strong> Please fill in the required information carefully.</div>

            <form action="/register" method="POST">
                <h2>Personal Information</h2>

                <div class="form-group">
                    <label>First Name:</label>
                    <input type="text" name="fn">
                </div>

                <div class="form-group">
                    <label>Last Name:</label>
                    <input type="text" name="ln">
                </div>

                <div class="form-group">
                    <label>Age:</label>
                    <input type="number" name="age">
                </div>

                <div class="form-group">
                    <label>Gender:</label>
                    <input type="text" name="gender">
                </div>

                <div class="form-group">
                    <label>Birthday:</label>
                    <input type="date" name="birthday">
                </div>

                <div class="form-group">
                    <label>Address:</label>
                    <input type="text" name="address">
                </div>

                <h2>Civil Status</h2>
                <div class="form-group">
                    <label>Civil Status:</label>
                    <input type="text" name="civilStatus">
                </div>

                <h2>Contact Number</h2>
                <div class="form-group">
                    <label>Contact Number:</label>
                    <input type="text" name="contactnumber">
                </div>

                <h2>Educational Background</h2>
                <div class="form-group">
                    <label>Elementary School:</label>
                    <input type="text" name="elementaryschool">
                </div>

                <div class="form-group">
                    <label>High School:</label>
                    <input type="text" name="highschool">
                </div>

                <div class="form-group">
                    <label>College / University:</label>
                    <input type="text" name="college">
                </div>

                <div class="form-group">
                    <label>Course:</label>
                    <input type="text" name="course">
                </div>

                <div class="form-group">
                    <label>Year Level:</label>
                    <input type="text" name="yearlevel">
                </div>

                <h2>Family Background</h2>
                <div class="form-group">
                    <label>Father's Name:</label>
                    <input type="text" name="father">
                </div>

                <div class="form-group">
                    <label>Mother's Name:</label>
                    <input type="text" name="mother">
                </div>

                <div class="form-group">
                    <label>Number of Siblings:</label>
                    <input type="number" name="siblings">
                </div>

                <h2>Hobbies</h2>
                <div class="form-group">
                    <label>Hobbies:</label>
                    <input type="text" name="hobbies">
                </div>

                <h2>Skills</h2>
                <div class="form-group">
                    <label>Skills:</label>
                    <input type="text" name="skills">
                </div>

                <button type="submit">Submit Biodata</button>
            </form>
        </div>
    </div>
</body>
</html>